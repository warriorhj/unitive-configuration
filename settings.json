{
  // 编辑器配置
  "editor.fontSize": 20, // 字体大小
  "editor.tabSize": 2, // tab键空格配置
  "editor.wordWrapColumn": 100,   // 超过100 后换行
  "editor.wordWrap": "bounded", // wordWrapColumn指定处这行 bounded在指定处和视宽的最小值除换行
  "editor.minimap.enabled": true, // 缩略图模式
  // "editor.suggestSelection": "first", // 优先选中第一项代码建议
  // "editor.snippetSuggestions": "top", // 代码片段优先显示
  "editor.formatOnSave": false, // 使用其他格式化工具时需要开启，和eslint格式化会冲突
  "editor.bracketPairColorization.enabled": true, // 启用括号对着色
  "editor.guides.bracketPairs": true, // 显示括号对指引线
  "editor.renderWhitespace": "boundary", // 仅在文本边界显示空格符号
  "editor.cursorSmoothCaretAnimation":"on", //光标平移动画
  "editor.smoothScrolling": true, // 编辑器平滑滚动
  "editor.cursorBlinking": "expand",
  "editor.mouseWheelZoom": true, //鼠标控制大小
  // "editor.suggest.insertMode": "replace", //接受建议模式，直接覆盖原有输入
  "editor.autoClosingBrackets": "beforeWhitespace",
  "editor.autoClosingDelete": "always",
  "editor.autoClosingOvertype": "always",
  "editor.autoClosingQuotes": "beforeWhitespace",
  "editor.detectIndentation": false, // 关闭自动调整缩进

  // 工作区配置
  "workbench.list.smoothScrolling": true, // 启用工作区列表平滑滚动

  // 文件配置
  "files.autoSave": "afterDelay", // 自动保存
  "files.autoSaveDelay": 200,
  "files.eol": "\n", // 统一换行符为 LF
  "files.trimTrailingWhitespace": true, // 删除行尾空格
  "files.insertFinalNewline": true, //文件末尾自动插入新行


  // 终端配置选项
  "terminal.integrated.fontSize": 14,
  "terminal.integrated.cursorBlinking": true, //光标闪烁
  "terminal.integrated.cursorStyle": "line",


  // 性能优化设置
  "search.exclude": {
    "**/node_modules": true,
    "**/dist": true, // 排除构建目录
  },

  // 格式化配置
  "eslint.format.enable": true, // 启用eslint格式化
  "eslint.validate": [
    "javascript",
    "javascriptreact",
    "typescript",
    "typescriptreact",
    "html",
    "vue"
  ], // eslint生效文件
  // 代码保存时，自动执行ESlint格式化代码
  "editor.codeActionsOnSave": {
    "source.fixAll": "explicit",
    // "source.fixAll.stylelint": "explicit"
  },

   // 设置标签页的最大显示数量
    "workbench.editor.limit.enabled": true,
    "workbench.editor.limit.value": 10,
    "workbench.editor.wrapTabs": true,
    "workbench.editor.scrollToSwitchTabs": true,
    "workbench.editor.highlightModifiedTabs": true,

    // 禁用预览模式，确保每个文件都打开新标签页
    "workbench.editor.enablePreview": false,
    "workbench.editor.enablePreviewFromQuickOpen": false,

    // 其他标签页相关设置
    "workbench.editor.showTabs": 'multiple',
    "workbench.editor.tabCloseButton": "right",
    "workbench.editor.tabSizing": "shrink",
    "workbench.editor.tabActionLocation": "right",

    // TODO-TREE配置
    "todo-tree.highlights.backgroundColourScheme": [
      "red",
      "orange",
      "yellow",
      "green",
      "blue",
      "indigo",
      "violet",
      ""
    ],

    "todo-tree.regex.regex": "(//|#|<!--|;|/\\*|^|^[ \\t]*(-|\\d+.))\\s*($TAGS)",
    "todo-tree.filtering.ignoreGitSubmodules": true,
    "todo-tree.tree.showCountsInTree": true,
    "todo-tree.regex.regexCaseSensitive": false,
    "todo-tree.general.statusBar":"current file",
    "todo-tree.general.tags": [
      "BUG", // 代码缺陷
      "FIXME", // 需要修复内容
      "TODO", // 待办
      "HACK", // 临时解决方案
      "XXX", // 待验证
      "TAG", // 标记
      "DONE",
      "NOTE", // 注释
      "INFO", // 信息提示
    ],
    "todo-tree.highlights.defaultHighlight": {
      "icon": "alert",
      "type": "line",
    },
    "todo-tree.highlights.customHighlight": {
      "BUG": {
          "icon": "bug",
          "foreground": "#F56C6C",
      },
      "FIXME": {
          "icon": "flame",
          "foreground": "#FF9800",
      },
      "TODO":{
          "icon": "checklist",
          "foreground": "#FFEB38",
      },
      "HACK":{
          "icon": "versions",
          "foreground": "#E040FB",
      },
      "XXX":{
          "icon": "unverified",
          "foreground": "#E91E63",
      },
      "TAG":{
          "icon": "tag",
          "foreground": "#409EFF",
      },
      "DONE": {
          "icon": "verified",
          "foreground": "#0dff00",
      },
      "NOTE":{
          "icon": "note",
          "foreground": "#67C23A",
      },
      "INFO":{
          "icon": "info",
          "foreground": "#909399",
      },
    },

  // "stylelint.validate": [
  //   "scss",
  //   "vue"
  // ]

}
